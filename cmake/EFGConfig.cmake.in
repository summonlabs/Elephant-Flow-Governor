@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET efg::efg)
    include("${CMAKE_CURRENT_LIST_DIR}/EFGTargets.cmake")
endif()

set(EFG_VERSION "@PROJECT_VERSION@")
set(EFG_LIBRARIES efg::efg)
set(EFG_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")

check_required_components(EFG)
